/* Theme: Cobalt - Ink-blue panels with a saturated cobalt accent and cool periwinkle support.
 *
 * Dark editor palette with deliberately separated surface values and a focused accent.
 * This file defines only ProjectOptimizer's --po-* theme tokens; layout remains in the base stylesheet.
 */

.po-root {
    --po-bg: rgb(10, 15, 25);
    --po-panel: rgb(23, 28, 38);
    --po-panel-2: rgb(39, 44, 53);
    --po-panel-3: rgb(57, 61, 69);
    --po-panel-4: rgb(76, 80, 87);
    --po-border: rgb(52, 56, 64);
    --po-border-soft: rgba(255, 255, 255, 0.06);
    --po-text: rgb(238, 238, 239);
    --po-text-dim: rgb(162, 164, 168);
    --po-text-faint: rgb(106, 109, 115);

    --po-accent: rgb(61, 124, 255);
    --po-accent-2: rgb(122, 162, 255);
    --po-accent-soft: rgba(61, 124, 255, 0.16);
    --po-accent-soft-2: rgba(61, 124, 255, 0.28);
    --po-accent-strong: rgb(90, 144, 255);

    --po-critical: rgb(255, 102, 112);
    --po-critical-soft: rgba(255, 102, 112, 0.16);
    --po-warning: rgb(255, 190, 86);
    --po-warning-soft: rgba(255, 190, 86, 0.16);
    --po-info: rgb(122, 162, 255);
    --po-info-soft: rgba(122, 162, 255, 0.16);
    --po-success: rgb(91, 224, 164);
    --po-success-soft: rgba(91, 224, 164, 0.16);

    --po-select-bg: rgb(37, 72, 145);
    --po-select-bg-inactive: rgb(54, 58, 66);
}
