/* Theme: Nebula (Dark) - deep purple panels with a vivid magenta accent.
 *
 * The most saturated of the six - for anyone who wants their tools to look a little more alive.
 * See ProjectOptimizerTheme_Obsidian.uss for what these tokens mean.
 */

.po-root {
    --po-bg: rgb(18, 12, 24);
    --po-panel: rgb(26, 18, 34);
    --po-panel-2: rgb(34, 24, 46);
    --po-panel-3: rgb(46, 32, 62);
    --po-panel-4: rgb(58, 42, 78);
    --po-border: rgb(56, 40, 74);
    --po-border-soft: rgba(255, 255, 255, 0.06);
    --po-text: rgb(238, 230, 245);
    --po-text-dim: rgb(178, 160, 195);
    --po-text-faint: rgb(126, 112, 145);

    --po-accent: rgb(232, 96, 220);
    --po-accent-2: rgb(120, 200, 255);
    --po-accent-soft: rgba(232, 96, 220, 0.18);
    --po-accent-soft-2: rgba(232, 96, 220, 0.30);
    --po-accent-strong: rgb(240, 130, 230);

    --po-critical: rgb(255, 92, 122);
    --po-critical-soft: rgba(255, 92, 122, 0.16);
    --po-warning: rgb(255, 176, 90);
    --po-warning-soft: rgba(255, 176, 90, 0.16);
    --po-info: rgb(120, 200, 255);
    --po-info-soft: rgba(120, 200, 255, 0.16);
    --po-success: rgb(100, 230, 180);
    --po-success-soft: rgba(100, 230, 180, 0.16);

    --po-select-bg: rgb(90, 50, 95);
    --po-select-bg-inactive: rgb(50, 38, 65);
}
