/* Theme: Aqua - Bright sea-glass surfaces with a saturated turquoise accent and marine-blue secondary.
 *
 * Light editor palette with soft surfaces, clear hierarchy, and a readable accent.
 * This file defines only ProjectOptimizer's --po-* theme tokens; layout remains in the base stylesheet.
 */

.po-root {
    --po-bg: rgb(227, 240, 240);
    --po-panel: rgb(238, 246, 246);
    --po-panel-2: rgb(247, 250, 250);
    --po-panel-3: rgb(217, 229, 229);
    --po-panel-4: rgb(203, 215, 215);
    --po-border: rgb(200, 211, 211);
    --po-border-soft: rgba(0, 0, 0, 0.05);
    --po-text: rgb(25, 26, 26);
    --po-text-dim: rgb(86, 91, 91);
    --po-text-faint: rgb(132, 139, 139);

    --po-accent: rgb(0, 143, 147);
    --po-accent-2: rgb(55, 117, 181);
    --po-accent-soft: rgba(0, 143, 147, 0.12);
    --po-accent-soft-2: rgba(0, 143, 147, 0.22);
    --po-accent-strong: rgb(0, 124, 128);

    --po-critical: rgb(198, 57, 72);
    --po-critical-soft: rgba(198, 57, 72, 0.12);
    --po-warning: rgb(165, 103, 0);
    --po-warning-soft: rgba(165, 103, 0, 0.12);
    --po-info: rgb(50, 105, 163);
    --po-info-soft: rgba(50, 105, 163, 0.12);
    --po-success: rgb(27, 137, 98);
    --po-success-soft: rgba(27, 137, 98, 0.12);

    --po-select-bg: rgb(163, 213, 214);
    --po-select-bg-inactive: rgb(204, 216, 216);
}
