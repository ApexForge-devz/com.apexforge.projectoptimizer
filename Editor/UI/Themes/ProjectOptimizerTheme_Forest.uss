/* Theme: Forest (Dark) - muted green-grey panels with a teal accent.
 *
 * Calmer and lower-contrast than the others by design. See ProjectOptimizerTheme_Obsidian.uss for
 * what these tokens mean.
 */

.po-root {
    --po-bg: rgb(13, 18, 16);
    --po-panel: rgb(18, 25, 22);
    --po-panel-2: rgb(24, 33, 29);
    --po-panel-3: rgb(33, 44, 39);
    --po-panel-4: rgb(42, 56, 49);
    --po-border: rgb(40, 52, 45);
    --po-border-soft: rgba(255, 255, 255, 0.05);
    --po-text: rgb(222, 232, 224);
    --po-text-dim: rgb(150, 168, 155);
    --po-text-faint: rgb(100, 116, 104);

    --po-accent: rgb(90, 210, 150);
    --po-accent-2: rgb(210, 200, 90);
    --po-accent-soft: rgba(90, 210, 150, 0.16);
    --po-accent-soft-2: rgba(90, 210, 150, 0.26);
    --po-accent-strong: rgb(120, 224, 172);

    --po-critical: rgb(240, 100, 90);
    --po-critical-soft: rgba(240, 100, 90, 0.16);
    --po-warning: rgb(230, 180, 70);
    --po-warning-soft: rgba(230, 180, 70, 0.16);
    --po-info: rgb(100, 190, 200);
    --po-info-soft: rgba(100, 190, 200, 0.16);
    --po-success: rgb(110, 220, 140);
    --po-success-soft: rgba(110, 220, 140, 0.16);

    --po-select-bg: rgb(45, 80, 62);
    --po-select-bg-inactive: rgb(38, 50, 44);
}
