/* Theme: Rosewood - Black cherry-brown surfaces with a wine-red accent and dusty blush secondary.
 *
 * Dark editor palette with deliberately separated surface values and a focused accent.
 * This file defines only ProjectOptimizer's --po-* theme tokens; layout remains in the base stylesheet.
 */

.po-root {
    --po-bg: rgb(20, 12, 15);
    --po-panel: rgb(33, 25, 28);
    --po-panel-2: rgb(48, 41, 44);
    --po-panel-3: rgb(65, 58, 61);
    --po-panel-4: rgb(83, 78, 80);
    --po-border: rgb(60, 53, 56);
    --po-border-soft: rgba(255, 255, 255, 0.06);
    --po-text: rgb(239, 238, 238);
    --po-text-dim: rgb(166, 163, 164);
    --po-text-faint: rgb(112, 107, 109);

    --po-accent: rgb(209, 91, 120);
    --po-accent-2: rgb(217, 154, 168);
    --po-accent-soft: rgba(209, 91, 120, 0.16);
    --po-accent-soft-2: rgba(209, 91, 120, 0.28);
    --po-accent-strong: rgb(216, 116, 140);

    --po-critical: rgb(255, 102, 112);
    --po-critical-soft: rgba(255, 102, 112, 0.16);
    --po-warning: rgb(255, 190, 86);
    --po-warning-soft: rgba(255, 190, 86, 0.16);
    --po-info: rgb(217, 154, 168);
    --po-info-soft: rgba(217, 154, 168, 0.16);
    --po-success: rgb(91, 224, 164);
    --po-success-soft: rgba(91, 224, 164, 0.16);

    --po-select-bg: rgb(118, 53, 70);
    --po-select-bg-inactive: rgb(62, 56, 58);
}
