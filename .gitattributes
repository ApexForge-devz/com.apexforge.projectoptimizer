# =====================================================
# GLOBAL BASELINE
# =====================================================

# Normalize line endings safely across OSes
* text=auto eol=lf

# =====================================================
# UNITY YAML / SERIALIZED TEXT ASSETS
# =====================================================
# These are YAML text files written by Unity and MUST:
# - be diffable
# - be merged using UnityYAMLMerge
# - keep LF line endings

[unityyaml]
text diff merge=unityyamlmerge eol=lf

*.unity                  unityyaml
*.prefab                 unityyaml
*.mat                    unityyaml
*.anim                   unityyaml
*.controller             unityyaml
*.overrideController     unityyaml
*.playable               unityyaml
*.mixer                  unityyaml
*.mask                   unityyaml
*.brush                  unityyaml
*.fontsettings           unityyaml
*.guiskin                unityyaml
*.preset                 unityyaml
*.shadervariants         unityyaml
*.terrainlayer           unityyaml
*.spriteatlas            unityyaml
*.lighting               unityyaml
*.physicMaterial         unityyaml
*.physicsMaterial2D      unityyaml
*.renderTexture          unityyaml
*.flare                  unityyaml
*.giparams               unityyaml

# Most .asset files are YAML → mergeable
*.asset                  unityyaml

# =====================================================
# UNITY BINARY .asset EXCEPTIONS (VERY IMPORTANT)
# =====================================================
# These are generated / binary / unsafe to merge

LightingData.asset           binary
NavMeshData.asset            binary
*TerrainData.asset           binary
*Terrain.asset               binary
*OcclusionCullingData.asset  binary
*ReflectionProbe*.asset      binary
*Lightmap*.asset             binary

# =====================================================
# UNITY META FILES
# =====================================================
# Meta files MUST:
# - always be text
# - never be binary
# - always diff cleanly

*.meta text diff eol=lf

# =====================================================
# SOURCE CODE / CONFIG FILES
# =====================================================

*.cs        text diff=csharp eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.asmdef    text diff eol=lf
*.asmref    text diff eol=lf

*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf

# UI Toolkit
*.uss       text eol=lf
*.uxml      text eol=lf

# =====================================================
# TEXTURES / IMAGES (BINARY)
# =====================================================

*.png       binary
*.jpg       binary
*.jpeg      binary
*.tga       binary
*.gif       binary
*.bmp       binary
*.tif       binary
*.tiff      binary
*.dds       binary
*.webp      binary

# =====================================================
# AUDIO (BINARY)
# =====================================================

*.mp3       binary
*.ogg       binary
*.aiff      binary
*.aif       binary
*.flac      binary

# =====================================================
# VIDEO (BINARY)
# =====================================================

*.mov       binary
*.avi       binary
*.mkv       binary
*.webm      binary

# =====================================================
# 3D MODELS (BINARY)
# =====================================================

*.obj       binary
*.blend     binary
*.dae       binary
*.3ds       binary
*.max       binary
*.ma        binary
*.mb        binary
*.glb       binary
*.gltf      binary

# =====================================================
# FONTS (BINARY)
# =====================================================

*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# =====================================================
# UNITY / NATIVE BINARIES
# =====================================================

*.cubemap        binary
*.unitypackage   binary
*.dll            binary
*.so             binary
*.dylib          binary
*.exe            binary
*.apk            binary
*.aab            binary

# =====================================================
# ARCHIVES / COMPRESSED FILES
# =====================================================

*.zip       binary
*.rar       binary
*.7z        binary
*.tar       binary
*.gz        binary

# =====================================================
# LOCK / TEMP / GENERATED
# =====================================================

*.lock      binary
*.tmp       binary
*.bak       binary

# =====================================================
# GIT LFS OPTIMIZATION (Remove if not using lfs)
# =====================================================

*.psd   filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
